{
  "name": "todo-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "test": "npm run test:tdd && npm run test:bdd",
    "test:tdd": "node tests/run-tdd.js",
    "test:bdd": "node tests/run-bdd.js",
    "test:bdd:mutation-check": "node tests/bdd/verify-negative-control.js",
    "test:mutation": "node tests/run-mutation.js",
    "test:summary": "node scripts/build-test-summary.js",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.65.1",
    "vitest": "^5.1.0"
  }
}
